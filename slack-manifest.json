{
  "display_information": {
    "name": "Moonshot Feature Hub",
    "description": "Detects feature requests in customer channels and links them to the Feature Hub for triage.",
    "background_color": "#0f6b5c"
  },
  "features": {
    "bot_user": {
      "display_name": "Moonshot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read",
        "links:read",
        "reactions:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_PUBLIC_URL/api/slack/events",
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
