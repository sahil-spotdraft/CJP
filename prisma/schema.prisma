generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FeatureRequestStatus {
  NEW
  TRIAGED
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

enum FeatureSignalStatus {
  PENDING
  MATCHED
  DISMISSED
}

enum SuggestionTriageStatus {
  PENDING
  MATCHED
  CREATED
  DISMISSED
}

enum FeatureRequestSourceType {
  SLACK
  JIRA
}

enum FeatureRequestActivityKind {
  NOTE
  SLACK
  JIRA
  STATUS
  SYSTEM
}

enum ClassificationJobStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

enum ClmPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ClmRequestStatus {
  NEW
  DISCUSSED_WITH_PRODUCT
  SHARED_WITH_PRODUCT
  IN_ROADMAP
  CLOSED
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  notes        FeatureRequestNote[]
  votes        Vote[]
  activities   FeatureRequestActivity[]
}

model CustomerOrg {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  arr             Float?
  csOwner         String?
  contractEndDate DateTime?
  lastActivityAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  channels        SlackChannel[]
  signals         FeatureSignal[]
  productRequests ProductRequest[]
  suggestionOrgs  SuggestionOrg[]
  retentionAlerts RetentionAlert[]
  activityMetrics WorkspaceActivityMetric[]
}

model RetentionAlert {
  id        String      @id @default(cuid())
  orgId     String
  org       CustomerOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind      String
  channel   String?
  message   String
  createdBy String?
  createdAt DateTime    @default(now())

  @@index([orgId])
  @@index([kind])
  @@index([createdAt])
}

// SpotDraft-style workspace usage counters for retention risk analysis.
// currentCount = last N days, priorCount = previous N days.
model WorkspaceActivityMetric {
  id           String      @id @default(cuid())
  orgId        String
  org          CustomerOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activityKey  String
  label        String
  currentCount Int         @default(0)
  priorCount   Int         @default(0)
  periodDays   Int         @default(30)
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  @@unique([orgId, activityKey])
  @@index([orgId])
}

model SlackChannel {
  id        String          @id @default(cuid())
  channelId String          @unique
  name      String
  enabled   Boolean         @default(true)
  orgId     String
  org       CustomerOrg     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  signals   FeatureSignal[]

  @@index([orgId])
}

model FeatureRequest {
  id          String               @id @default(cuid())
  title       String
  summary     String
  status      FeatureRequestStatus @default(NEW)
  dueDate     DateTime?
  embedding   Json?
  roadmapId   String?
  roadmap     RoadmapItem?         @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  signals     FeatureSignal[]
  notes       FeatureRequestNote[]
  tags        FeatureRequestTag[]
  votes       Vote[]
  sources     FeatureRequestSource[]
  activities  FeatureRequestActivity[]
  consolidation   Consolidation?
  productRequests ProductRequest[]
  suggestionMatches SuggestionMatch[]
  resolvedSuggestions Suggestion[]

  @@index([status])
  @@index([roadmapId])
  @@index([dueDate])
}

model FeatureRequestSource {
  id               String                   @id @default(cuid())
  featureRequestId String
  featureRequest   FeatureRequest           @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  type             FeatureRequestSourceType
  label            String
  url              String
  externalId       String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  activities       FeatureRequestActivity[]

  @@index([featureRequestId])
  @@index([type])
}

model FeatureRequestActivity {
  id               String                      @id @default(cuid())
  featureRequestId String
  featureRequest   FeatureRequest              @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  kind             FeatureRequestActivityKind  @default(NOTE)
  title            String
  body             String?
  occurredAt       DateTime                    @default(now())
  sourceId         String?
  source           FeatureRequestSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  authorId         String?
  author           User?                       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt        DateTime                    @default(now())

  @@index([featureRequestId, occurredAt])
  @@index([sourceId])
}

// Demo "suggestion" from a Slack ask — same core fields as FeatureRequest,
// plus source metadata and unread state for the home notification bell.
model Suggestion {
  id               String                 @id @default(cuid())
  title            String
  summary          String
  status           FeatureRequestStatus   @default(NEW)
  embedding        Json?
  rawText          String?
  sourceLabel      String                 @default("slack")
  tags             String[]               @default([])
  readAt           DateTime?
  triageStatus     SuggestionTriageStatus @default(PENDING)
  triageNote       String?
  featureRequestId String?
  featureRequest   FeatureRequest?        @relation(fields: [featureRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  matches          SuggestionMatch[]
  orgs             SuggestionOrg[]

  @@index([createdAt])
  @@index([readAt])
  @@index([triageStatus])
  @@index([featureRequestId])
}

// Workspaces (accounts) that raised this suggestion / should be added to the request.
model SuggestionOrg {
  suggestionId String
  orgId        String
  suggestion   Suggestion  @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  org          CustomerOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([suggestionId, orgId])
  @@index([orgId])
}

model SuggestionMatch {
  id               String         @id @default(cuid())
  suggestionId     String
  suggestion       Suggestion     @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  matchPercent     Int
  createdAt        DateTime       @default(now())

  @@unique([suggestionId, featureRequestId])
  @@index([suggestionId])
  @@index([featureRequestId])
}

model FeatureSignal {
  id              String              @id @default(cuid())
  status          FeatureSignalStatus @default(PENDING)
  rawText         String
  aiTitle         String?
  aiSummary       String?
  aiConfidence    Float?
  aiTags          String[]            @default([])
  slackUserId     String?
  slackUserName   String?
  slackTs         String
  threadTs        String?
  botReplyTs      String?
  permalink       String?
  triageNote      String?
  orgId           String
  org             CustomerOrg         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelId       String
  channel         SlackChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  featureRequestId String?
  featureRequest  FeatureRequest?     @relation(fields: [featureRequestId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  classification  ClassificationJob?

  @@unique([channelId, slackTs])
  @@index([status])
  @@index([orgId])
  @@index([featureRequestId])
}

model FeatureRequestNote {
  id               String         @id @default(cuid())
  body             String
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([featureRequestId])
}

model Tag {
  id        String              @id @default(cuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  requests  FeatureRequestTag[]
}

model FeatureRequestTag {
  featureRequestId String
  tagId            String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  tag              Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([featureRequestId, tagId])
}

model Vote {
  id               String         @id @default(cuid())
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([featureRequestId, userId])
}

model RoadmapItem {
  id          String           @id @default(cuid())
  title       String
  theme       String?
  quarter     String?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requests    FeatureRequest[]
}

model ClassificationJob {
  id           String                  @id @default(cuid())
  status       ClassificationJobStatus @default(PENDING)
  model        String?
  prompt       String?
  responseJson Json?
  error        String?
  signalId     String?                 @unique
  signal       FeatureSignal?          @relation(fields: [signalId], references: [id], onDelete: Cascade)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model AppSetting {
  id        String   @id @default("default")
  confidenceThreshold Float @default(0.7)
  threadReplyEnabled  Boolean @default(true)
  updatedAt DateTime @updatedAt
}

// Canonical grouping bucket that multiple CLM product requests roll up into.
// ARR shown for a consolidation is derived (not stored) from the ARR of every
// distinct workspace among its linked ProductRequest rows, so it grows as more
// workspaces ask for the same feature.
// CS owners are directory entries (name + email) assigned to product requests —
// separate from login Users.
model CsOwner {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productRequests ProductRequest[]
}

model Consolidation {
  id               String           @id @default(cuid())
  name             String           @unique
  feature          String?
  notes            String?
  featureRequestId String?          @unique
  featureRequest   FeatureRequest?  @relation(fields: [featureRequestId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  requests         ProductRequest[]
}

// One row of the "Product Requests CLM" sheet: Account, Account ARR (via org),
// Request/Ask, Consolidation, CS Owner, Priority, Status, Product Notes,
// Timeline, CS Notes.
model ProductRequest {
  id               String            @id @default(cuid())
  orgId            String
  org              CustomerOrg       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ask              String
  consolidationId  String?
  consolidation    Consolidation?    @relation(fields: [consolidationId], references: [id], onDelete: SetNull)
  featureRequestId String?
  featureRequest   FeatureRequest?   @relation(fields: [featureRequestId], references: [id], onDelete: SetNull)
  csOwnerId        String?
  csOwner          CsOwner?          @relation(fields: [csOwnerId], references: [id], onDelete: SetNull)
  priority         ClmPriority?
  status           ClmRequestStatus  @default(NEW)
  productNotes     String?
  timeline         String?
  csNotes          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([orgId])
  @@index([consolidationId])
  @@index([featureRequestId])
  @@index([csOwnerId])
  @@index([status])
  @@unique([consolidationId, orgId])
}
