# App
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql://moonshot:moonshot@localhost:5433/moonshot?schema=public

# Seed admin (used by prisma/seed.ts)
ADMIN_EMAIL=admin@moonshot.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# Slack (bot xoxb- preferred; user access token also works for Web API)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_REFRESH_TOKEN=
SLACK_SIGNING_SECRET=your-signing-secret
# Optional fallback channel for CS retention alerts when an org has no linked Slack channel
RETENTION_SLACK_CHANNEL=

# AI (OpenAI-compatible)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# Cursor SDK agent (spawned per Slack message)
CURSOR_API_KEY=
CURSOR_AGENT_ENABLED=true
CURSOR_AGENT_MODEL=composer-2.5
SLACK_POLL_CHANNEL_ID=C0BMJFWC96J
SLACK_POLL_CHANNEL_NAME=cjp_customer_org
SLACK_POLL_INTERVAL_MS=45000
SLACK_MCP_URL=https://mcp.slack.com/mcp
SLACK_MCP_CLIENT_ID=3660753192626.8903469228982
